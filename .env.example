# Do not paste actual values into the repository, logs, CI artifacts or chat.
NODE_ENV=production
PORT=3000
ADMIN_API_TOKEN=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
HYP_ENV=sandbox
HYP_ENABLE_LIVE=NO
HYP_ALLOW_PRODUCTION=NO
HYP_API_KEY=
HYP_API_EMAIL=
HYP_DEVELOPER_EMAIL=
# Mapping must be verified against HYP sandbox (no guessed default).
HYP_PAYMENT_CODES_JSON={}
# Optional independent Google Drive archiving. An HYP-native Google Drive sync can be enabled instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ARCHIVE_FOLDER_ID=
GOOGLE_INBOX_FOLDER_ID=
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=
# Optional private Google Sheets ledger sync (HYP issuance works without these).
# Use ONE mode only. Store values as GitHub Actions Secrets, never in Git history.
# Mode A: base64-encoded JSON service account with Editor access to the single existing Sheet.
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON_B64=
# Mode B: previously authorized Google OAuth refresh credentials with Sheets edit scope.
# Existing GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN above may be used.
# Without either mode, periodic ledger sync reports NOT_CONFIGURED (no live Sheets writes).
